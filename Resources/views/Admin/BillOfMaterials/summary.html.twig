{% apply spaceless %}
    <p>
        <strong>[{{ subject.reference }}]</strong>
        {{ subject.designation }}
    </p>
    <table class="table table-condensed">
        <thead>
        <tr>
            <th>Reference</th>
            <th>Designation</th>
            <th>Quantity</th>
        </tr>
        </thead>
        <tbody>
        {% for component in components %}
        <tr>
            <td>{{ component.reference }}</td>
            <td>{{ component.designation }}</td>
            <td>{{ component.quantity|format_number }}</td>
        </tr>
        </tbody>
        {% endfor %}
    </table>
{% endapply %}
