{% extends '@EkynaAdmin/Entity/Crud/read.html.twig' %}


{% import '@EkynaCommerce/Admin/macros.html.twig' as macros %}


{% block main_actions %}
    {{ admin_resource_btn(billOfMaterials, 'Ekyna\\Bundle\\AdminBundle\\Action\\UpdateAction') }}
    {% if billOfMaterials.state == constant('Ekyna\\Component\\Commerce\\Manufacture\\Model\\BOMState::DRAFT') %}
        {{ admin_resource_btn(billOfMaterials, 'Ekyna\\Bundle\\CommerceBundle\\Action\\Admin\\BillOfMaterials\\ValidateAction') }}
        {{ admin_resource_btn(billOfMaterials, 'Ekyna\\Bundle\\AdminBundle\\Action\\DeleteAction') }}
    {% elseif billOfMaterials.state == constant('Ekyna\\Component\\Commerce\\Manufacture\\Model\\BOMState::VALIDATED') %}
        {{ admin_resource_btn(billOfMaterials, 'Ekyna\\Bundle\\CommerceBundle\\Action\\Admin\\BillOfMaterials\\CreatePOAction') }}
        {{ admin_resource_btn(billOfMaterials, 'Ekyna\\Bundle\\CommerceBundle\\Action\\Admin\\BillOfMaterials\\DuplicateAction') }}
        {{ admin_resource_btn(billOfMaterials, 'Ekyna\\Bundle\\CommerceBundle\\Action\\Admin\\BillOfMaterials\\ArchiveAction') }}
    {% endif %}
{% endblock main_actions %}


{% block main_tabs -%}
    <li class="active">
        <a href="#{{ resource_name }}-general" id="toggle-general" data-toggle="tab">
            {{- 'field.general'|trans({}, 'EkynaUi') -}}
        </a>
    </li>
    <li>
        <a href="#{{ resource_name }}-components" id="toggle-components" data-toggle="tab">
            {{- 'field.components'|trans({}, 'EkynaCommerce') -}}
        </a>
    </li>
    <li>
        <a href="#{{ resource_name }}-orders" id="toggle-orders" data-toggle="tab">
            {{- 'production_order.label.plural'|trans({}, 'EkynaCommerce') -}}
        </a>
    </li>
{%- endblock main_tabs %}


{% block main_contents -%}
    <div class="tab-pane active" id="{{ resource_name }}-general">
        <div class="row">
            <div class="col-md-6">
                {{- show_row(billOfMaterials.number|ui_clipboard_copy, 'text', {
                    'label': t('field.number', [], 'EkynaUi'),
                    'label_col': 4
                }) -}}
            </div>
            <div class="col-md-6">
                {{- show_row(billOfMaterials.version, 'text', {
                    'label': t('field.version', [], 'EkynaUi'),
                    'label_col': 4
                }) -}}
            </div>
        </div>
        <div class="row">
            <div class="col-md-6">
                {{- show_row(billOfMaterials.state|enum_badge, 'text', {
                    'label': t('field.status', [], 'EkynaUi'),
                    'label_col': 4
                }) -}}
            </div>
            <div class="col-md-6">
                {{- show_row(billOfMaterials.createdAt, 'datetime', {
                    'label': t('field.date', [], 'EkynaUi'),
                    'time_format': 'none',
                    'label_col': 4
                }) -}}
            </div>
        </div>
        {{ macros.show_subject(billOfMaterials, t('subject.label.singular', [], 'EkynaCommerce')) }}
        <div class="row">
            <div class="col-md-6">
                {{ show_row(billOfMaterials.cost|format_currency(commerce_default_currency), 'text', {
                    'label': t('bill_of_materials.field.cost', [], 'EkynaCommerce'),
                    'label_col': 4
                }) }}
            </div>
        </div>
        {{ show_row(billOfMaterials.description, 'textarea', {
            'label': t('field.description', [], 'EkynaCommerce'),
        }) }}
    </div>
    <div class="tab-pane" id="{{ resource_name }}-components">
        <table class="table table-condensed table-striped">
            <thead>
            <tr>
                <th>{{ 'field.reference'|trans({}, 'EkynaUi') }}</th>
                <th>{{ 'subject.label.singular'|trans({}, 'EkynaCommerce') }}</th>
                <th>{{ 'field.quantity'|trans({}, 'EkynaUi') }}</th>
                <th>{{ 'field.buy_net_price'|trans([], 'EkynaCommerce') }}</th>
                <th>{{ 'field.total'|trans({}, 'EkynaUi') }}</th>
            </tr>
            </thead>
            <tbody>
            {% for component in billOfMaterials.components -%}
                {% set subject = component|subject_get(false) %}
                <tr>
                    <td>
                        {{ subject.reference|ui_clipboard_copy }}
                    </td>
                    <td>
                        {% set url = subject|subject_private_url %}
                        {% if url is not null %}
                            <a href="{{ url }}" class="show-entity"{{ admin_resource_summary(subject) }}>{{ subject }}</a>
                        {% else %}
                            {{ subject }}
                        {% endif %}
                    </td>
                    <td class="text-right">
                        {# TODO Packaging format #}
                        {{- component.quantity|format_number -}}
                    </td>
                    <td class="text-right">
                        {{- subject|subject_purchase_cost.getTotal(false)|format_currency(commerce_default_currency) -}}
                    </td>
                    <td class="text-right">
                        {{ component|bom_component_total_cost.getTotal(false)|format_currency(commerce_default_currency) }}
                    </td>
                </tr>
            {%- endfor %}
            <tr>
                <td colspan="4"></td>
                <td class="text-right">
                    <strong>
                        {{ billOfMaterials|bill_of_materials_cost.getTotal(false)|format_currency(commerce_default_currency) }}
                    </strong>
                </td>
            </tr>
            </tbody>
        </table>
    </div>
    <div class="tab-pane" id="{{ resource_name }}-orders">
        {{- render_subject_production_orders(billOfMaterials|subject_get) -}}
    </div>
{%- endblock main_contents %}
