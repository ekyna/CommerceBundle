{% extends '@EkynaCommerce/Admin/Common/Attachment/list.html.twig' %}


{% block before_list %}
<h4 class="sub-header">
    {# TODO Permission #}
    <a href="{{ admin_resource_path('ekyna_commerce.supplier_order_attachment', 'Ekyna\\Bundle\\AdminBundle\\Action\\CreateAction') }}"
       class="btn btn-primary btn-xs pull-right">
        {{ 'attachment.button.new'|trans({}, 'EkynaCommerce') }}
    </a>
    {{ 'attachment.label.plural'|trans({}, 'EkynaCommerce') }}
</h4>
<div class="text-center">
    <ul class="list-inline">
    {% for label, type in supplier_order_attachment_types() %}
        <li>
        {% if supplierOrder.hasAttachments(type) %}
            <label class="label label-success">
                <i class="glyphicon glyphicon-ok"></i>
                {{ label|trans({}, 'EkynaCommerce') }}
            </label>
        {% else %}
            <label class="label label-warning">
                <i class="glyphicon glyphicon-remove"></i>
                {{ label|trans({}, 'EkynaCommerce') }}
            </label>
        {% endif %}
        </li>
    {% endfor %}
    </ul>
</div>
{% endblock before_list %}


{% block header_internal %}{% endblock %}


{% block cell_type -%}
    <td id="{{ attachmentId }}_type">{{ attachment.type|supplier_order_attachment_type_label }}</td>
{%- endblock %}


{% block cell_internal %}{% endblock %}
