{% apply spaceless %}
{% set map_params = {'label': null, 'map_width': 520, 'map_height': 160, 'map_zoom': 17, 'map_static': false} %}
<div class="row">
    <div class="col-md-6">
        <div class="row show-row">
            <div class="col-md-4 show-label">
                {{ 'sale.field.invoice_address'|trans({}, 'EkynaCommerce') }}
            </div>
            <div class="col-md-8">
                {%- if sale.invoiceAddress is not null -%}
                <div class="panel panel-default">
                    <div class="panel-body" id="sale_invoiceAddress">
                        {{ sale.invoiceAddress|address }}
                    </div>
                </div>
                {%- else -%}
                <div class="show-widget show-widget-inline" id="sale_invoiceAddress">
                    <em>{{ 'value.undefined'|trans({}, 'EkynaUi') }}</em>
                </div>
                {%- endif -%}
            </div>
        </div>
    </div>
    <div class="col-md-6">
        {% if sale.invoiceAddress is not null %}
            {{- show_row(sale.invoiceAddress, 'google_map', map_params) -}}
        {% endif %}
    </div>
</div>
<div class="row">
    <div class="col-md-6">
        <div class="row show-row">
            <div class="col-md-4 show-label">
                {{ 'sale.field.delivery_address'|trans({}, 'EkynaCommerce') }}
            </div>
            <div class="col-md-8">
            {%- if sale.deliveryAddress is not null -%}
            <div class="panel panel-default">
                <div class="panel-body" id="sale_deliveryAddress">
                    {{ sale.deliveryAddress|address }}
                </div>
            </div>
            {%- else -%}
            <div class="show-widget show-widget-inline" id="sale_deliveryAddress">
                <em>{{ 'sale.field.same_address'|trans({}, 'EkynaCommerce') }}</em>
            </div>
            {%- endif -%}
            </div>
        </div>
    </div>
    <div class="col-md-6">
        {% if sale.deliveryAddress is not null -%}
            {{- show_row(sale.deliveryAddress, 'google_map', map_params) -}}
        {%- endif %}
    </div>
</div>
{% if sale.destinationAddress is not null -%}
<div class="row">
    <div class="col-md-6">
        <div class="row show-row">
            <div class="col-md-4 show-label">
                {{ 'sale.field.destination_address'|trans({}, 'EkynaCommerce') }}
            </div>
            <div class="col-md-8">
                <div class="panel panel-default">
                    <div class="panel-body" id="sale_destinationAddress">
                        {{ sale.destinationAddress|address }}
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        {% if sale.destinationAddress is not null -%}
            {{- show_row(sale.destinationAddress, 'google_map', map_params) -}}
        {%- endif %}
    </div>
</div>
{%- endif %}
{% if sale.relayPoint is not null -%}
<div class="row">
    <div class="col-md-6">
        <div class="row show-row">
            <div class="col-md-4 show-label">
                {{ 'relay_point.label.singular'|trans({}, 'EkynaCommerce') }}
            </div>
            <div class="col-md-8">
                <div class="panel panel-default">
                    <div class="panel-body" id="sale_relayPoint">
                        {{- sale.relayPoint|address -}}
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        {{- show_row(sale.relayPoint, 'google_map', map_params) -}}
    </div>
</div>
{%- endif %}
{% endapply %}
{{ ivory_google_api() }}
