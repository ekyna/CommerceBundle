<div class="form-body">
    {{ bootstrap_set_style('horizontal') }}
    {{ bootstrap_set_col_size('md') }}
    <div class="row">
        <div class="col-md-6">
            {{ form_row(form.startAt, {'label_col': 4, 'widget_col': 8}) }}
        </div>
        <div class="col-md-6">
            {{ form_row(form.endAt, {'label_col': 4, 'widget_col': 8}) }}
        </div>
    </div>
    {{ form_row(form.confirm) }}
    {{ form_rest(form) }}
</div>
