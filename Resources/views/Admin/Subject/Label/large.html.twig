{% extends '@EkynaCommerce/Admin/Subject/Label/base.html.twig' %}

{% block styles %}
    <style>
        @media print {
            html,
            body {
                margin: 0;
                padding: 0;
                text-rendering: optimizeLegibility;
                width: 100%;
                height: 100%;
                font-size: 14px;
                line-height: 1.4;
            }

            .label {
                page-break-after: always;
                overflow: hidden;
                box-sizing: border-box;
                width: 100%;
                height: 100%;
            }
        }

        .label {
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .label > p {
            flex: 1 1 initial;
            margin: 0;
            padding: 0;
            text-align: center;
            text-overflow: ellipsis;
            overflow: hidden;
        }

        .label > .barcode > img {
            width: 100%;
            height: 100%;
        }

        .label > .large {
            font-size: 28px;
        }

        .label > .medium {
            font-size: 18px;
        }
    </style>
{% endblock styles %}

{% block label %}
    <div class="label">
        <p class="medium">{{ label.designation|default('&nbsp;')|raw }}</p>
        <p class="large">{{ label.reference|default('&nbsp;')|raw }}</p>
        {% if label['reference_aliases'] is defined %}
        <p>({{ label['reference_aliases']|join(', ') }})</p>
        {% endif %}
        <p class="large">{{ label.geocode|default('&nbsp;')|raw }}</p>
        <p>{{ label.orderedAt|default('&nbsp;')|raw }}</p>
        <p class="barcode">
            {%- if label.barcode is not empty -%}
                <img alt="barcode" src="data:image/png;base64,{{ label.barcode|barcode_128(256, 40) }}">
            {%- else -%}
                &nbsp;
            {%- endif -%}
        </p>
        <p>{{ label.barcode|default('&nbsp;')|raw }}</p>
    </div>
{% endblock label %}
