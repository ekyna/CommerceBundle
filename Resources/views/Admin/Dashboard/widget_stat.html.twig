{% import '@EkynaCommerce/Admin/Dashboard/_macro.html.twig' as macros %}

{% apply spaceless %}
<div class="row">
    <div class="col-lg-4 commerce-stat-day">
        {{ macros.render_stat_panel(
            type~'_daily_stats',
            t('dashboard.stat.'~type~'.daily', [], 'EkynaCommerce'),
            current_day,
            compare_day
        ) }}
        {{ macros.render_stat_chart(type~'_daily_chart', daily_chart) }}
    </div>

    <div class="col-lg-4 commerce-stat-month">
        {{ macros.render_stat_panel(
            type~'_monthly_stats',
            t('dashboard.stat.'~type~'.monthly', [], 'EkynaCommerce'),
            current_month,
            compare_month
        ) }}
        {{ macros.render_stat_chart(type~'_monthly_chart', monthly_chart) }}
    </div>

    <div class="col-lg-4 commerce-stat-year">
        {{ macros.render_stat_panel(
            type~'_yearly_stats',
            t('dashboard.stat.'~type~'.yearly', [], 'EkynaCommerce'),
            current_year,
            compare_year,
            aggregate_year
        ) }}
        {{ macros.render_stat_chart(type~'_yearly_chart', yearly_chart) }}
    </div>
</div>
{% endapply %}
