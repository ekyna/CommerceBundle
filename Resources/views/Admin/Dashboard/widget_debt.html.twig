{% import '@EkynaCommerce/Admin/Dashboard/_macro.html.twig' as macros %}


{% macro link(route, label, export) %}
    {% if export %}<a href="{{ path(route) }}" target="_blank">{% endif %}
        {{ label|trans({}, 'EkynaCommerce') }}
    {% if export %}</a>{% endif %}
{% endmacro %}


{% apply spaceless %}
<div class="row">
    <div class="col-md-4 commerce-debt-customer">
        <div class="commerce-panel">
            <h3>
                {{ _self.link('admin_ekyna_commerce_export_all_due_orders', 'dashboard.debt.title.customer', export) }}
            </h3>
            <table>
                <tbody>
                <tr>
                    <th>
                        {{ _self.link('admin_ekyna_commerce_export_due_invoices', 'dashboard.debt.field.due_invoices', export) }}
                    </th>
                    <td>{{ due_invoices|format_currency(commerce_default_currency) }}</td>
                </tr>
                <tr>
                    <th>
                        {{ _self.link('admin_ekyna_commerce_export_fall_invoices', 'dashboard.debt.field.fall_invoices', export) }}
                    </th>
                    <td><em>{{ fall_invoices|format_currency(commerce_default_currency) }}</em></td>
                </tr>
                <tr>
                    <th>
                        {{ _self.link('admin_ekyna_commerce_export_remaining_orders', 'dashboard.debt.field.remaining_orders', export) }}
                    </th>
                    <td><em>{{ remaining_orders|format_currency(commerce_default_currency) }}</em></td>
                </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="col-md-4 commerce-debt-supplier">
        <div class="commerce-panel">
            <h3>{{ 'dashboard.debt.title.supplier'|trans({}, 'EkynaCommerce') }}</h3>
            <table>
                <tbody>
                <tr>
                    <th>
                        {{ _self.link('admin_ekyna_commerce_export_suppliers_expired_due_orders', 'dashboard.debt.field.expired', export) }}
                    </th>
                    <td>{{ supplier_expired|format_currency(commerce_default_currency) }}</td>
                </tr>
                <tr>
                    <th>
                        {{ _self.link('admin_ekyna_commerce_export_suppliers_fall_due_orders', 'dashboard.debt.field.fall', export) }}
                    </th>
                    <td>{{ supplier_fall|format_currency(commerce_default_currency) }}</td>
                </tr>
                <tr>
                    <th>{{ 'dashboard.debt.field.total'|trans({}, 'EkynaCommerce') }}</th>
                    <td><strong>{{ (supplier_expired+supplier_fall)|format_currency(commerce_default_currency) }}</strong></td>
                </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="col-md-4 commerce-debt-carrier">
        <div class="commerce-panel">
            <h3>{{ 'dashboard.debt.title.carrier'|trans({}, 'EkynaCommerce') }}</h3>
            <table>
                <tbody>
                <tr>
                    <th>
                        {{ _self.link('admin_ekyna_commerce_export_forwarders_expired_due_orders', 'dashboard.debt.field.expired', export) }}
                    </th>
                    <td>{{ carrier_expired|format_currency(commerce_default_currency) }}</td>
                </tr>
                <tr>
                    <th>
                        {{ _self.link('admin_ekyna_commerce_export_forwarders_fall_due_orders', 'dashboard.debt.field.fall', export) }}
                    </th>
                    <td>{{ carrier_fall|format_currency(commerce_default_currency) }}</td>
                </tr>
                <tr>
                    <th>{{ 'dashboard.debt.field.total'|trans({}, 'EkynaCommerce') }}</th>
                    <td><strong>{{ (carrier_expired+carrier_fall)|format_currency(commerce_default_currency) }}</strong></td>
                </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endapply %}
